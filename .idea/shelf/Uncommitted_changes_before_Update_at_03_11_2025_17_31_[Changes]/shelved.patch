+from lab_python_fp import gen_random
+from gen_random import gen_random
+
+
+class Unique(object):
+    def __init__(self, data, ignore_case=False, **kwargs):
+        self.ignore_case = kwargs.get('ignore_case')
+        self.data = iter(data)
+        self.unique = set()
+
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        while True:
+            element = next(self.data)
+            diff = element.upper() if self.ignore_case else element
+            if diff not in self.unique:
+                self.unique.add(element)
+                yield element
+
+
+numbers = gen_random(5, 1, 5)
