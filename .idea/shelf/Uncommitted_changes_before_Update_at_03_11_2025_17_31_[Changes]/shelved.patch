+import random
+
+
+def gen_random(num_count: int, begin: int, end: int):
+    try:
+        for i in range(num_count):
+            yield random.randint(begin, end)
+
+    except:
+        return TypeError("Ошибка. Убедитесь, что в аргументы функции вы передали целые числа")
+
