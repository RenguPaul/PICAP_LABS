+from typing import List, Dict
+import sys
+
+
+def field(data: List[Dict], *args):
+    try:
+        assert len(args) > 0
+        if len(args) == 1:
+            key = args[0]
+            for item in data:
+                if key in item and item[key] is not None:
+                    print(item[key])
+        else:
+            for item in data:
+                filtered_item = {
+                    key: item[key]
+                    for key in args
+                    if key in item and item[key] is not None
+                }
+                if filtered_item:
+                    print(filtered_item)
+
+    except AssertionError:
+        print("Нет аргументов. Попробуйте перезапустить программу и попробовать ещё раз")
+        sys.exit()
+
+
+goods = [
+    {'title': 'Ковер', 'price': 2000, 'color': 'green'},
+    {'title': 'Диван для отдыха', 'price': 5300, 'color': 'black'}
+]
+
+field(goods, 'title', 'price')
